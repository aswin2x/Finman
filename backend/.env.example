# Copy to .env and edit before first run.

# PostgreSQL in production. SQLite works for local development:
#   DATABASE_URL=sqlite:///./finman.db
DATABASE_URL=postgresql+psycopg://finman:finman@localhost:5432/finman

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-you-run-this-anywhere-real

ENVIRONMENT=development
DEBUG=false

ACCESS_TOKEN_MINUTES=720
REFRESH_TOKEN_DAYS=30

CURRENCY=INR
TIMEZONE=Asia/Kolkata

# The only two accounts. Change these before seeding.
USER_ONE_USERNAME=aswin
USER_ONE_DISPLAY_NAME=Aswin
USER_ONE_PASSWORD=aswin1234
USER_TWO_USERNAME=salini
USER_TWO_DISPLAY_NAME=Salini
USER_TWO_PASSWORD=salini1234

# Set to false in production so demo data cannot be seeded.
ALLOW_DEMO_SEED=true
